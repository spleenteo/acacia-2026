  "narrative": {
    "northStar": "The Quiet Concierge",
    "overview": "Il sito parla come un concierge discreto: tutto è calmo e nitido, il colore compare dove serve e non prima. Un serif ad alto contrasto dà la voce editoriale, un sans leggibile porta il testo di servizio, i fondi alternano bianco, sage e sand come pagine di una guida. L'unico gesto \"a mano\" è l'evidenziatore sghembo.",
    "keyCharacteristics": [
      "Serif Fraunces nel suo taglio più affilato, corsivo solo per la parola chiave del titolo.",
      "Fondo navy mai nero puro, azioni sempre color blackberry.",
      "Superfici piatte a riposo, angoli netti da 4px, bottoni a pillola.",
      "Evidenziatori a parallelogramma (wonkyClip) come firma.",
      "Movimento lento e morbido, disattivato con prefers-reduced-motion."
    ],
    "rules": [
      {
        "name": "The One Action Rule",
        "body": "Blackberry Ink è il colore di ogni azione primaria. Rust, gold, sage e slate non fanno mai da CTA.",
        "section": "colors"
      },
      {
        "name": "The No Pure Black Rule",
        "body": "Il nero più scuro è Night Navy. Un #000 è un errore.",
        "section": "colors"
      },
      {
        "name": "The One Italic Rule",
        "body": "In un titolo, una sola parola va in corsivo Fraunces peso 400 color Blackberry Ink.",
        "section": "typography"
      },
      {
        "name": "The Sharp Cut Rule",
        "body": "Fraunces non si usa mai con WONK o SOFT attivi.",
        "section": "typography"
      },
      {
        "name": "The Flat-By-Default Rule",
        "body": "Una superficie ferma non ha ombra. L'ombra è la risposta a un gesto.",
        "section": "elevation"
      },
      {
        "name": "The Inverted Action Rule",
        "body": "Su Night Navy l'azione primaria si inverte in Surface Sand con testo Night Navy, hover Gold Soft. Il blackberry resta l'azione sui fondi chiari.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do usare Blackberry Ink (#48182f) per ogni azione primaria su fondo chiaro e per il corsivo dei titoli; su Night Navy vale l'Inverted Action Rule.",
      "Do tenere le superfici piatte a riposo e dare rilievo solo in hover.",
      "Do passare ogni nuovo evidenziatore da wonkyClip(seed) con un seme stabile.",
      "Do rispettare prefers-reduced-motion.",
      "Do aggiungere uno stato :focus-visible visibile a ogni elemento interattivo nuovo.",
      "Do far parlare le foto per prime nelle pagine di dettaglio: impatto prima, verifica subito dopo.",
      "Do su fondo scuro tingere i kicker di Gold (#ffaa4d) e il testo secondario di bianco al 60-70%."
    ],
    "donts": [
      "Don't usare nero puro: il più scuro è Night Navy (#00012a).",
      "Don't colorare una CTA con rust, gold, sage o slate.",
      "Don't attivare WONK o SOFT su Fraunces.",
      "Don't mettere ombre a riposo sulle card.",
      "Don't togliere l'outline di un campo senza un sostituto visibile.",
      "Don't usare @import url() per i font.",
      "Don't usare il verde WhatsApp come fondo di un pulsante con testo bianco (1,98:1): il verde resta nell'icona."
    ]
  }
